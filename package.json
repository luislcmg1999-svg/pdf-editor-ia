{
  "name": "editor-pdf-local",
  "version": "1.0.0",
  "description": "Editor de PDF 100% offline: texto, resaltado, dibujo, firma, IA (Kimi u otra)",
  "main": "main.js",
  "author": "Tu nombre",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "offline": "node offline-setup.js",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tunombre.editorpdf",
    "productName": "Editor PDF Pro",
    "directories": { "output": "dist" },
    "files": [ "main.js", "app/**/*", "offline-setup.js" ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Editor PDF" }
  }
}
